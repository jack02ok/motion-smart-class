# MOTION SMART CLASS - Firebase Configuration
# Salin file ini menjadi .env atau .env.local dan isi dengan konfigurasi dari Firebase Console
# Project Settings -> General -> Your apps -> Web app (SDK setup and configuration)

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=motion-smart-class.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=motion-smart-class
VITE_FIREBASE_STORAGE_BUCKET=motion-smart-class.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Email admin yang diizinkan membuka pengaturan. Bukan secret dan akan terlihat di bundle browser.
# Password tidak boleh ditulis di file .env; password dikelola Firebase Authentication.
VITE_ADMIN_EMAIL=admin@example.com
