rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'super_admin', 'owner'];
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'owner'];
    }

    function validQuestionData(question) {
      return question.keys().hasOnly([
          'id', 'category', 'topic', 'grade', 'difficulty', 'passage',
          'question', 'options', 'correctAnswer', 'explanation', 'timeLimit',
          'pointWeight', 'gestureMap', 'imageUrl', 'imageAlt', 'imageLayout', 'createdAt', 'updatedAt', 'source'
        ])
        && question.question is string
        && question.question.size() > 0
        && question.question.size() <= 1000
        && question.options is list
        && question.options.size() >= 2
        && question.options.size() <= 4
        && question.correctAnswer is int
        && question.correctAnswer >= 0
        && question.correctAnswer < question.options.size();
    }

    function validQuestion() {
      return validQuestionData(request.resource.data);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.uid == uid
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.keys().hasOnly([
          'uid', 'role', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'
        ]);
      // Self-service profiles cannot change role. Elevated roles are provisioned
      // through Firebase Admin SDK or Firebase Console.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'updatedAt'
        ]);
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validQuestion();
      allow delete: if isAdmin();
    }

    match /question_submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.id == submissionId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerRole in ['student', 'teacher']
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewerUid == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewNote == ''
        && request.resource.data.keys().hasOnly([
          'id', 'ownerUid', 'ownerRole', 'ownerName', 'ownerEmail', 'status',
          'question', 'submittedAt', 'updatedAt', 'reviewerUid', 'reviewedAt', 'reviewNote'
        ])
        && validQuestionData(request.resource.data.question);
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewerUid', 'reviewedAt', 'updatedAt', 'reviewNote'
        ]);
      allow delete: if isAdmin();
    }

    match /game_sessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.accuracy is number
        && request.resource.data.keys().hasOnly([
          'id', 'date', 'mode', 'category', 'grade', 'score', 'correctCount',
          'wrongCount', 'totalQuestions', 'accuracy', 'avgResponseTimeSec',
          'topicMastery', 'weakTopics', 'studentName', 'teamId', 'roomCode',
          'participantResults', 'source', 'ownerUid'
        ])
        && request.resource.data.participantResults is list
        && request.resource.data.participantResults.size() <= 100;
      allow read: if isTeacher() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if false;
      allow delete: if isTeacher() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /msc_rooms/{roomCode} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.roomCode == roomCode
        && request.resource.data.keys().hasOnly([
          'roomCode', 'hostId', 'hostUid', 'hostName', 'createdAt', 'status',
          'settings', 'questions', 'currentQuestionIndex', 'questionStartedAt',
          'countdownSec', 'players', 'leaderboard'
        ]);
      allow update: if isRoomHostUpdate() || isOwnPlayerUpdate();
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      function isRoomHostUpdate() {
        return signedIn()
          && resource.data.hostUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid;
      }

      function isOwnPlayerUpdate() {
        let uid = request.auth.uid;
        let changedRoomFields = request.resource.data.diff(resource.data).affectedKeys();
        let changedPlayers = request.resource.data.players.diff(resource.data.players).affectedKeys();
        return signedIn()
          && changedRoomFields.hasOnly(['players'])
          && changedPlayers.hasOnly([uid])
          && request.resource.data.players[uid].id == uid
          && (
            (!(uid in resource.data.players)
              && request.resource.data.players[uid].score == 0
              && request.resource.data.players[uid].correctCount == 0
              && request.resource.data.players[uid].name is string
              && request.resource.data.players[uid].name.size() > 0
              && request.resource.data.players[uid].name.size() <= 40
              && request.resource.data.players[uid].keys().hasOnly([
                'id', 'name', 'participantType', 'avatar', 'score', 'streak', 'correctCount',
                'hasAnswered', 'lastAnswer', 'answerTimeMs', 'isCorrect',
                'joinedAt'
              ])
              && request.resource.data.players[uid].participantType in ['student', 'group'])
            ||
            ((uid in resource.data.players)
              && request.resource.data.players[uid].diff(resource.data.players[uid]).affectedKeys()
                .hasOnly(['hasAnswered', 'lastAnswer', 'answerTimeMs'])
              && request.resource.data.players[uid].hasAnswered == true
              && request.resource.data.players[uid].lastAnswer in ['A', 'B', 'C', 'D']
              && request.resource.data.players[uid].answerTimeMs is number
              && request.resource.data.players[uid].answerTimeMs >= 0
              && request.resource.data.players[uid].answerTimeMs <= 300000)
          );
      }
    }

    // Correct answers and explanations are scoped to the anonymous host session.
    match /msc_room_secrets/{roomCode} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['hostUid', 'questions', 'createdAt']);
      allow read, delete: if signedIn() && resource.data.hostUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid;
    }
  }
}
